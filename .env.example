# Copie para .env e preencha. O .env nunca vai para o git.
#
# Banco da plataforma de dados (data-hub-pafil). O schema "integracao" mora nele.
# Em desenvolvimento, o normal e abrir um tunel SSH ate a VM e apontar para
# localhost:5433. Com o tunel, PG_SSLMODE=disable e aceitavel, porque o trafego
# nao sai da maquina. Qualquer conexao direta pela rede deve usar "require".
PG_HOST=localhost
PG_PORT=5433
PG_DB=pafil_dw
PG_USER=
PG_PASSWORD=
PG_SSLMODE=disable
